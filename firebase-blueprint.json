{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "authMethod": { "type": "string" },
        "language": { "type": "string" },
        "grade": { "type": "number" },
        "isPro": { "type": "boolean" },
        "avatarUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "language", "grade"]
    },
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "Study material history item generated by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "materialTitle": { "type": "string" },
        "date": { "type": "string" },
        "data": { "type": "object" }
      },
      "required": ["id", "userId", "type", "title"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Payment verification request for Telebirr / Chapa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "telebirrRef": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "telebirrRef", "amount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document keyed by Auth UID"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/HistoryItem" },
      "description": "User's generated study history subcollection"
    },
    "/paymentRequests/{requestId}": {
      "schema": { "$ref": "#/entities/PaymentRequest" },
      "description": "Payment verification queue for admin approval"
    }
  }
}
