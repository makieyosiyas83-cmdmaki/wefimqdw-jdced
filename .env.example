# ================================================================
# EduEthiopia AI - Environment Variables & Configuration
# ================================================================

# 1. Google Gemini AI API Key (REQUIRED)
# Get your free or paid API key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. Server & Hosting Settings
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# 3. Owner Admin Portal Credentials
# Used to unlock the admin dashboard to review payment receipts & grant PRO
VITE_ADMIN_EMAIL="admin@eduethiopia.et"
VITE_ADMIN_PASSWORD="admin123456"
ADMIN_EMAIL="admin@eduethiopia.et"

# 4. Telebirr Payment & Monetization Settings
# The Telebirr mobile number and name displayed to students for transfers
VITE_TELEBIRR_PHONE="0912345678"
VITE_TELEBIRR_NAME="EduEthiopia Store"
VITE_PRO_PRICE_ETB="500"
TELEBIRR_RECEIVER_PHONE="0912345678"

# 5. Support & Contact
VITE_SUPPORT_EMAIL="support@eduethiopia.et"

# 6. (Optional) Database Configuration - Firebase or Supabase
# The application comes pre-configured with local offline state + Firebase Firestore.
# If using Supabase, see README.md for the Supabase schema and REST endpoints.
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
